# .env.example
# Copy this file to .env and populate with your local development values.
# The .env file is listed in .gitignore and must never be committed.

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment: development | staging | production
APP_ENV=development

# Application port (default: 8080)
APP_PORT=8080

# =============================================================================
# SECRETS & API KEYS
# =============================================================================

# Replace with actual keys for your project.
# Example: third-party API key
# API_KEY=your_api_key_here

# Example: database connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# =============================================================================
# CI/CD SECRETS (configured in GitHub Repository Secrets, not here)
# =============================================================================
# The following secrets are required in GitHub Settings → Secrets → Actions:
#
#   ANTHROPIC_API_KEY   — Required by claude-action.yml
#   SEMGREP_APP_TOKEN   — Required by semgrep.yml (optional for open-source scans)
